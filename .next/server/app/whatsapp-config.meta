{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/(app)/layout,_N_T_/(app)/whatsapp-config/layout,_N_T_/(app)/whatsapp-config/page,_N_T_/whatsapp-config"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/!KGFwcCk/whatsapp-config/__PAGE__",
    "/!KGFwcCk/whatsapp-config",
    "/!KGFwcCk",
    "/_index",
    "/_head"
  ]
}